{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with display name and email",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "MissionPlan": {
      "title": "MissionPlan",
      "description": "User saved rover mission trajectory and metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string" },
        "name": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 5000 },
        "status": { "type": "string" },
        "roverProfile": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "terrainImage": { "type": "string" },
        "imageProvenance": { "type": "object" },
        "startPoint": { "type": "object" },
        "destinationPoint": { "type": "object" },
        "obstacles": { "type": "array" },
        "segmentedHazards": { "type": "array" },
        "detectionMethod": { "type": "string" },
        "scienceTargets": { "type": "array" },
        "selectedStrategy": { "type": "string" },
        "routeMetrics": { "type": "object" },
        "rawRoutePath": { "type": "array" },
        "simulationState": { "type": "object" },
        "checkpoints": { "type": "array" },
        "traversalLog": { "type": "array" },
        "validationPassed": { "type": "boolean" },
        "isArchived": { "type": "boolean" }
      },
      "required": ["id", "userId", "name", "createdAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Chat message in conversation history",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "model", "system"] },
        "content": { "type": "string", "maxLength": 10000 },
        "modelUsed": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "role", "content", "timestamp"]
    },
    "GeologicalTargetObservation": {
      "title": "GeologicalTargetObservation",
      "description": "Operator-updated exploration status and field notes for a segmented geological target region",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "imageKey": { "type": "string", "maxLength": 160 },
        "imageName": { "type": "string", "maxLength": 240 },
        "targetId": { "type": "string", "maxLength": 128 },
        "regionId": { "type": "string", "maxLength": 64 },
        "targetName": { "type": "string", "maxLength": 200 },
        "status": {
          "type": "string",
          "enum": ["DETECTED", "Not Investigated", "Planned", "In Progress", "Sample Collected", "Completed", "Rejected"]
        },
        "notes": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time", "maxLength": 64 },
        "updatedAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["id", "userId", "imageKey", "regionId", "status", "notes", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile records"
    },
    "/users/{userId}/missions/{missionId}": {
      "schema": { "$ref": "#/entities/MissionPlan" },
      "description": "Saved rover exploration missions by user"
    },
    "/users/{userId}/chatMessages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Saved Gemini chat conversation messages by user"
    },
    "/users/{userId}/geologicalTargets/{targetKey}": {
      "schema": { "$ref": "#/entities/GeologicalTargetObservation" },
      "description": "Persisted exploration status and notes for image-segmented geological targets"
    }
  }
}
