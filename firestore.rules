rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
             data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'createdAt']) &&
             data.uid == userId &&
             data.email is string && data.email.size() <= 254 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 2000)) &&
             data.createdAt is string;
    }

    function isValidMission(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'name', 'createdAt']) &&
             data.userId == userId &&
             data.name is string && data.name.size() <= 200 &&
             (!('status' in data) || data.status is string) &&
             (!('roverProfile' in data) || data.roverProfile is string) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 5000)) &&
             (!('terrainImage' in data) || data.terrainImage is string) &&
             (!('imageProvenance' in data) || data.imageProvenance is map) &&
             (!('startPoint' in data) || data.startPoint is map) &&
             (!('destinationPoint' in data) || data.destinationPoint is map) &&
             (!('obstacles' in data) || data.obstacles is list) &&
             (!('segmentedHazards' in data) || data.segmentedHazards is list) &&
             (!('detectionMethod' in data) || data.detectionMethod is string) &&
             (!('scienceTargets' in data) || data.scienceTargets is list) &&
             (!('selectedStrategy' in data) || data.selectedStrategy is string) &&
             (!('routeMetrics' in data) || data.routeMetrics is map) &&
             (!('rawRoutePath' in data) || data.rawRoutePath is list) &&
             (!('simulationState' in data) || data.simulationState is map) &&
             (!('checkpoints' in data) || data.checkpoints is list) &&
             (!('traversalLog' in data) || data.traversalLog is list) &&
             (!('validationPassed' in data) || data.validationPassed is bool) &&
             (!('isArchived' in data) || data.isArchived is bool) &&
             (!('updatedAt' in data) || data.updatedAt is string) &&
             data.createdAt is string;
    }

    function isValidChatMessage(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'role', 'content', 'timestamp']) &&
             data.keys().hasOnly(['id', 'userId', 'role', 'content', 'modelUsed', 'timestamp']) &&
             data.userId == userId &&
             data.role in ['user', 'model', 'system'] &&
             data.content is string && data.content.size() <= 10000 &&
             (!('modelUsed' in data) || (data.modelUsed is string && data.modelUsed.size() <= 100)) &&
             data.timestamp is string;
    }

    // Connection testing
    match /test/connection {
      allow read: if true;
    }

    // User profile documents
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidUserProfile(incoming(), userId) && incoming().uid == existing().uid;

      // Saved Missions Subcollection
      match /missions/{missionId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(missionId) && isValidMission(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(missionId) && isValidMission(incoming(), userId);
        allow delete: if isOwner(userId) && isValidId(missionId);
      }

      // Chat Messages Subcollection
      match /chatMessages/{messageId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(messageId) && isValidChatMessage(incoming(), userId);
        allow delete: if isOwner(userId) && isValidId(messageId);
      }
    }

    // Public Benchmark Datasets
    match /datasets/{datasetId} {
      allow read: if true;
      allow write: if isSignedIn() && (request.auth.token.email == 'riteshganguly0911@gmail.com');
    }
  }
}
