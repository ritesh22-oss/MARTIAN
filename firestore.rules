rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
             data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'createdAt']) &&
             data.uid == userId &&
             data.email is string && data.email.size() <= 254 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 2000)) &&
             data.createdAt is string;
    }

    function isValidMission(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'createdAt']) &&
             data.keys().hasOnly(['id', 'userId', 'title', 'routeType', 'distanceM', 'energyWh', 'notes', 'createdAt']) &&
             data.userId == userId &&
             data.title is string && data.title.size() <= 200 &&
             (!('routeType' in data) || (data.routeType is string && data.routeType.size() <= 50)) &&
             (!('distanceM' in data) || data.distanceM is number) &&
             (!('energyWh' in data) || data.energyWh is number) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 5000)) &&
             data.createdAt is string;
    }

    function isValidChatMessage(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'role', 'content', 'timestamp']) &&
             data.keys().hasOnly(['id', 'userId', 'role', 'content', 'modelUsed', 'timestamp']) &&
             data.userId == userId &&
             data.role in ['user', 'model', 'system'] &&
             data.content is string && data.content.size() <= 10000 &&
             (!('modelUsed' in data) || (data.modelUsed is string && data.modelUsed.size() <= 100)) &&
             data.timestamp is string;
    }

    // Connection testing
    match /test/connection {
      allow read: if true;
    }

    // User profile documents
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidUserProfile(incoming(), userId) && incoming().uid == existing().uid;

      // Saved Missions Subcollection
      match /missions/{missionId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(missionId) && isValidMission(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(missionId) && isValidMission(incoming(), userId);
        allow delete: if isOwner(userId) && isValidId(missionId);
      }

      // Chat Messages Subcollection
      match /chatMessages/{messageId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(messageId) && isValidChatMessage(incoming(), userId);
        allow delete: if isOwner(userId) && isValidId(messageId);
      }
    }
  }
}
